# CreditRisk.AI Frontend Environment Configuration
# Copy this file to .env or .env.production when deploying the frontend

# Backend API endpoint URL (must include the /api prefix)
# Local development default:
VITE_API_BASE_URL=http://localhost:8000/api

# Cloud Production example (uncomment for deployment):
# VITE_API_BASE_URL=https://creditrisk-api.yourdomain.com/api
